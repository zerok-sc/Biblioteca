@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<h1>Gestión de biblioteca</h1>

<div class="perfil">
    <div>
        @if (!string.IsNullOrEmpty(Model.Imagen))
        {
            <img height="64" width="64" class="foto"
                 src="data:@Model.TipoImagen;base64,@Model.Imagen"
                 alt="Foto de perfil" />
        }
        else
        {
            <div class="foto sin-foto" style="width:64px;height:64px">Sin foto</div>
        }
    </div>
    <div>
        <p>Bienvenido, @User.Identity?.Name</p>
        <a asp-page="/Perfil" class="ayuda">Cambiar foto</a>
    </div>
</div>

@if (ViewData.ContainsKey("Mensaje"))
{
    @await Html.PartialAsync("~/Pages/Emergentes/Mensajes.cshtml");
}

@if (Model.EsOperador)
{
    <h2>Resumen operativo</h2>
    <ul class="tarjetas resumen">
        <li>Préstamos activos <strong>@Model.PrestamosActivos</strong></li>
        <li>Atrasados <strong>@Model.PrestamosAtrasados</strong></li>
        <li>Por vencer (3 días) <strong>@Model.PrestamosPorVencer</strong></li>
        <li>Ejemplares disponibles <strong>@Model.EjemplaresDisponibles</strong></li>
        <li>Multas pendientes <strong>@Model.MultasPendientes</strong></li>
        <li>Valor multas <strong>$ @Model.ValorMultasPendientes.ToString("N0")</strong></li>
    </ul>

    <p>
        <a class="boton" asp-page="/Ventanas/Prestamos">Registrar préstamo</a>
        <a class="boton boton-claro" asp-page="/Ventanas/Multas">Ver multas</a>
        @if (User.IsInRole(Codigos.RolAdmin))
        {
            <a class="boton boton-claro" asp-page="/CrearUsuario">Crear usuario</a>
        }
    </p>

    @if (Model.Atrasados.Count > 0)
    {
        <h2>Préstamos atrasados</h2>
        <table>
            <thead>
                <tr>
                    <th>id</th>
                    <th>Usuario</th>
                    <th>Ejemplares</th>
                    <th>Fecha final</th>
                    <th>Atraso</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Atrasados)
                {
                    <tr>
                        <td>@item.id</td>
                        <td>@Model.NombrePersona(item.persona)</td>
                        <td>@Model.Ejemplares(item)</td>
                        <td>@item.fecha_fin.ToString("dd/MM/yyyy")</td>
                        <td><span class="etiqueta etiqueta-atrasado">@Model.Situacion(item)</span></td>
                        <td>
                            <a class="boton boton-claro" asp-page="/Comprobante"
                               asp-route-tipo="prestamo" asp-route-id="@item.id">Comprobante</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="aviso">No hay préstamos atrasados.</p>
    }

    @if (Model.PorVencer.Count > 0)
    {
        <h2>Próximos vencimientos</h2>
        <table>
            <thead>
                <tr>
                    <th>id</th>
                    <th>Usuario</th>
                    <th>Ejemplares</th>
                    <th>Fecha final</th>
                    <th>Situación</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.PorVencer)
                {
                    <tr>
                        <td>@item.id</td>
                        <td>@Model.NombrePersona(item.persona)</td>
                        <td>@Model.Ejemplares(item)</td>
                        <td>@item.fecha_fin.ToString("dd/MM/yyyy")</td>
                        <td><span class="etiqueta @Model.ClaseSituacion(item)">@Model.Situacion(item)</span></td>
                        <td>
                            <a class="boton boton-claro" asp-page="/Comprobante"
                               asp-route-tipo="prestamo" asp-route-id="@item.id">Comprobante</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
else
{
    <ul class="tarjetas resumen">
        <li>Libros <strong>@Model.TotalLibros</strong></li>
        <li>Autores <strong>@Model.TotalAutores</strong></li>
        <li>Ejemplares disponibles <strong>@Model.EjemplaresDisponibles</strong></li>
    </ul>
    <p><a class="boton" asp-page="/MisPrestamos">Mis préstamos y multas</a></p>
}

