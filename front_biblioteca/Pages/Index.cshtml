@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<h1>Gestión de biblioteca</h1>
<p>Los datos se consultan a la WebAPI y esta a la base de datos.</p>

@if (ViewData.ContainsKey("Mensaje"))
{
    @await Html.PartialAsync("~/Pages/Emergentes/Mensajes.cshtml");
}

<ul class="tarjetas resumen">
    <li>Libros: <strong>@Model.TotalLibros</strong></li>
    <li>Autores: <strong>@Model.TotalAutores</strong></li>
    <li>Préstamos: <strong>@Model.TotalPrestamos</strong></li>
    <li>Usuarios: <strong>@Model.TotalUsuarios</strong></li>
</ul>

<p>Seleccione una entidad para administrar sus registros.</p>
<ul class="tarjetas">
        @if (Model.PuedeVer("Auditorias"))
