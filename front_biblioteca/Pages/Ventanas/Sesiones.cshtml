@page
@model SesionesModel
@{
    ViewData["Title"] = "Sesiones";
}

<h1>Sesiones</h1>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="aviso">@Model.Mensaje</div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="error">@Model.Error</div>
}

<form method="post">
    <button class="boton" asp-page-handler="Nuevo">Nuevo registro</button>
</form>

@if (Model.MostrarFormulario)
{
    <form method="post">
        <input type="hidden" asp-for="Actual.id" />
        <div class="campos">
            <div><label>Usuario</label><input asp-for="Actual.usuario" /></div>
            <div><label>Fecha inicio</label><input asp-for="Actual.fecha_inicio" /></div>
            <div><label>Fecha fin</label><input asp-for="Actual.fecha_fin" /></div>
            <div><label>Direccion ip</label><input asp-for="Actual.direccion_ip" /></div>
            <div><label>Agente usuario</label><input asp-for="Actual.agente_usuario" /></div>
            <div><label>Exitoso</label><input asp-for="Actual.exitoso" /></div>
            <div><label>Motivo fallo</label><input asp-for="Actual.motivo_fallo" /></div>
        </div>
        <button class="boton" asp-page-handler="Guardar">Guardar</button>
    </form>
}

<table>
    <thead>
        <tr>
            <th>id</th>
            <th>Usuario</th>
            <th>Fecha inicio</th>
            <th>Fecha fin</th>
            <th>Direccion ip</th>
            <th>Agente usuario</th>
            <th>Exitoso</th>
            <th>Motivo fallo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.id</td>
                <td>@item.usuario</td>
                <td>@item.fecha_inicio</td>
                <td>@item.fecha_fin</td>
                <td>@item.direccion_ip</td>
                <td>@item.agente_usuario</td>
                <td>@item.exitoso</td>
                <td>@item.motivo_fallo</td>
                <td>
                    <form method="post" style="display:inline">
                        <input type="hidden" name="id" value="@item.id" />
                        <button class="boton boton-claro" asp-page-handler="Editar">Editar</button>
                        <button class="boton boton-peligro" asp-page-handler="Borrar">Borrar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
