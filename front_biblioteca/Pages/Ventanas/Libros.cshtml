@page
@model LibrosModel
@{
    ViewData["Title"] = "Libros";
}

<h1>Libros</h1>

@if (ViewData.ContainsKey("Mensaje"))
{
    @await Html.PartialAsync("~/Pages/Emergentes/Mensajes.cshtml");
}

<form method="post" class="barra">
    <input name="Buscar" value="@Model.Buscar" placeholder="Buscar por codigo o nombre" />
    <select asp-for="CategoriaFiltro" asp-items="Model.Catalogos.OpcionesCategorias"></select>
    <button class="boton" asp-page-handler="Consultar">Consultar</button>
    @if (!User.IsInRole(Codigos.RolLector))
    {
        <button class="boton" asp-page-handler="Nuevo">Nuevo registro</button>
    }
</form>

@if (Model.MostrarFormulario)
{
    <form method="post">
        <input type="hidden" asp-for="Actual.id" />
        <div class="campos">
            <div><label>Codigo</label><input asp-for="Actual.codigo" /></div>
            <div><label>Nombre</label><input asp-for="Actual.nombre" /></div>
            <div>
                <label>Editorial</label>
                <select asp-for="Actual.editorial" required asp-items="Model.Catalogos.OpcionesEditoriales">
                </select>
            </div>
            <div>
                <label>Idioma</label>
                <select asp-for="Actual.idioma" required asp-items="Model.Catalogos.OpcionesIdiomas">
                </select>
            </div>
        </div>
        @if (!User.IsInRole(Codigos.RolLector))
        {
            <button class="boton" asp-page-handler="Guardar">Guardar</button>
        }
    </form>
}

<table>
    <thead>
        <tr>
            <th>id</th>
            <th>Codigo</th>
            <th>Nombre</th>
            <th>Editorial</th>
            <th>Idioma</th>
            <th>Autores</th>
            <th>Categorías</th>
            <th>Disponibles</th>
            @if (!User.IsInRole(Codigos.RolLector)) { <th>Acciones</th> }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.id</td>
                <td>@item.codigo</td>
                <td>@item.nombre</td>
                <td>@Model.Catalogos.NombreEditorial(item.editorial)</td>
                <td>@Model.Catalogos.NombreIdioma(item.idioma)</td>
                <td>@Model.Catalogos.AutoresDe(item.id)</td>
                <td>@Model.Catalogos.CategoriasDe(item.id)</td>
                <td>@Model.Disponibles(item.id)</td>
                @if (!User.IsInRole(Codigos.RolLector))
                {
                    <td>
                        <form method="post" style="display:inline">
                            <input type="hidden" name="id" value="@item.id" />
                            @if (!User.IsInRole(Codigos.RolLector))
                            {
                                <button class="boton boton-claro" asp-page-handler="Editar">Editar</button>
                                <button class="boton boton-peligro" asp-page-handler="Borrar">Borrar</button>
                            }
                        </form>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
