@page
@model UbicacionesModel
@{
    ViewData["Title"] = "Ubicaciones";
}

<h1>Ubicaciones</h1>

@if (ViewData.ContainsKey("Mensaje"))
{
    @await Html.PartialAsync("~/Pages/Emergentes/Mensajes.cshtml");
}

<form method="post" class="barra">
    <input name="Buscar" value="@Model.Buscar" placeholder="Buscar por codigo o nombre" />
    <button class="boton" asp-page-handler="Consultar">Consultar</button>
    @if (!User.IsInRole("LECTOR"))
    {
        <button class="boton" asp-page-handler="Nuevo">Nuevo registro</button>
    }
</form>

@if (Model.MostrarFormulario)
{
    <form method="post">
        <input type="hidden" asp-for="Actual.id" />
        <div class="campos">
            <div><label>Codigo</label><input asp-for="Actual.codigo" /></div>
            <div><label>Piso</label><input asp-for="Actual.piso" /></div>
            <div><label>Descripcion</label><input asp-for="Actual.descripcion" /></div>
            <div>
                <label>Estanteria</label>
                <select asp-for="Actual.estanteria" required asp-items="Model.Catalogos.OpcionesEstanterias">
                </select>
            </div>
        </div>
        @if (!User.IsInRole("LECTOR"))
        {
            <button class="boton" asp-page-handler="Guardar">Guardar</button>
        }
    </form>
}

<table>
    <thead>
        <tr>
            <th>id</th>
            <th>Codigo</th>
            <th>Piso</th>
            <th>Descripcion</th>
            <th>Estanteria</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.id</td>
                <td>@item.codigo</td>
                <td>@item.piso</td>
                <td>@item.descripcion</td>
                <td>@Model.Catalogos.NombreEstanteria(item.estanteria)</td>
                <td>
                    <form method="post" style="display:inline">
                        <input type="hidden" name="id" value="@item.id" />
                        @if (!User.IsInRole("LECTOR"))
                        {
                            <button class="boton boton-claro" asp-page-handler="Editar">Editar</button>
                            <button class="boton boton-peligro" asp-page-handler="Borrar">Borrar</button>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
