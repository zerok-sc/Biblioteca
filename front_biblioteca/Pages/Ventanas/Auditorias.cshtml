@page
@model AuditoriasModel
@{
    ViewData["Title"] = "Auditorias";
}

<h1>Auditorias</h1>

@if (ViewData.ContainsKey("Mensaje"))
{
    @await Html.PartialAsync("~/Pages/Emergentes/Mensajes.cshtml");
}

<form method="post" class="barra">
    <input name="Buscar" value="@Model.Buscar" placeholder="Buscar por codigo o nombre" />
    <button class="boton" asp-page-handler="Consultar">Consultar</button>
</form>

<p class="ayuda">Las auditorías son solo lectura: no se pueden crear, editar ni borrar registros.</p>

<table>
    <thead>
        <tr>
            <th>id</th>
            <th>Entidad</th>
            <th>Entidad id</th>
            <th>Operacion</th>
            <th>Fecha</th>
            <th>Valores anteriores</th>
            <th>Valores nuevos</th>
            <th>Nombre usuario</th>
            <th>Direccion ip</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.id</td>
                <td>@item.entidad</td>
                <td>@item.entidad_id</td>
                <td>@item.operacion</td>
                <td>@item.fecha</td>
                <td>@item.valores_anteriores</td>
                <td>@item.valores_nuevos</td>
                <td>@item.nombre_usuario</td>
                <td>@item.direccion_ip</td>
            </tr>
        }
    </tbody>
</table>
