@page
@model AuditoriasModel
@{
    ViewData["Title"] = "Auditorias";
}

<h1>Auditorias</h1>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="aviso">@Model.Mensaje</div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="error">@Model.Error</div>
}

<form method="post">
    <button class="boton" asp-page-handler="Nuevo">Nuevo registro</button>
</form>

@if (Model.MostrarFormulario)
{
    <form method="post">
        <input type="hidden" asp-for="Actual.id" />
        <div class="campos">
            <div><label>Entidad</label><input asp-for="Actual.entidad" /></div>
            <div><label>Entidad id</label><input asp-for="Actual.entidad_id" /></div>
            <div><label>Operacion</label><input asp-for="Actual.operacion" /></div>
            <div><label>Fecha</label><input asp-for="Actual.fecha" /></div>
            <div><label>Valores anteriores</label><input asp-for="Actual.valores_anteriores" /></div>
            <div><label>Valores nuevos</label><input asp-for="Actual.valores_nuevos" /></div>
            <div><label>Nombre usuario</label><input asp-for="Actual.nombre_usuario" /></div>
            <div><label>Direccion ip</label><input asp-for="Actual.direccion_ip" /></div>
        </div>
        <button class="boton" asp-page-handler="Guardar">Guardar</button>
    </form>
}

<table>
    <thead>
        <tr>
            <th>id</th>
            <th>Entidad</th>
            <th>Entidad id</th>
            <th>Operacion</th>
            <th>Fecha</th>
            <th>Valores anteriores</th>
            <th>Valores nuevos</th>
            <th>Nombre usuario</th>
            <th>Direccion ip</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.id</td>
                <td>@item.entidad</td>
                <td>@item.entidad_id</td>
                <td>@item.operacion</td>
                <td>@item.fecha</td>
                <td>@item.valores_anteriores</td>
                <td>@item.valores_nuevos</td>
                <td>@item.nombre_usuario</td>
                <td>@item.direccion_ip</td>
                <td>
                    <form method="post" style="display:inline">
                        <input type="hidden" name="id" value="@item.id" />
                        <button class="boton boton-claro" asp-page-handler="Editar">Editar</button>
                        <button class="boton boton-peligro" asp-page-handler="Borrar">Borrar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
