@page
@model MultasModel
@{
    ViewData["Title"] = "Multas";
}

<h1>Multas</h1>

@if (ViewData.ContainsKey("Mensaje"))
{
    @await Html.PartialAsync("~/Pages/Emergentes/Mensajes.cshtml");
}

<form method="post" class="barra">
    <input type="number" name="FiltroId" value="@Model.FiltroId" placeholder="Buscar por id" />
    <button class="boton" asp-page-handler="Consultar">Consultar</button>
    @if (!User.IsInRole("LECTOR"))
    {
        <button class="boton" asp-page-handler="Nuevo">Nuevo registro</button>
    }
    <a class="boton boton-claro" asp-page-handler="Exportar">Exportar Excel (CSV)</a>
</form>

@if (Model.MostrarFormulario)
{
    <form method="post">
        <input type="hidden" asp-for="Actual.id" />
        <div class="campos">
            <div><label>Valor</label><input asp-for="Actual.valor" /></div>
            <div><label>Fecha</label><input asp-for="Actual.fecha" /></div>
            <div>
                <label>Prestamo libro</label>
                <select asp-for="Actual.prestamo_libro" required asp-items="Model.Catalogos.OpcionesPrestamosLibros">
                </select>
            </div>
            <div>
                <label>Estado</label>
                <select asp-for="Actual.estado" required asp-items="Model.Catalogos.OpcionesEstadosMulta">
                </select>
            </div>
        </div>
        @if (!User.IsInRole("LECTOR"))
        {
            <button class="boton" asp-page-handler="Guardar">Guardar</button>
        }
    </form>
}

<table>
    <thead>
        <tr>
            <th>id</th>
            <th>Usuario</th>
            <th>Libro</th>
            <th>Valor</th>
            <th>Días atraso</th>
            <th>Fecha</th>
            <th>Prestamo libro</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.id</td>
                <td>@Model.NombrePersona(item)</td>
                <td>@Model.NombreLibro(item)</td>
                <td>@item.valor.ToString("N0")</td>
                <td>@Model.DiasAtraso(item)</td>
                <td>@item.fecha.ToString("dd/MM/yyyy")</td>
                <td>@Model.Catalogos.NombrePrestamoLibro(item.prestamo_libro)</td>
                <td>@Model.Catalogos.NombreEstado(item.estado)</td>
                <td>
                    <div class="acciones">
                        <a class="boton boton-claro" asp-page="/Comprobante"
                           asp-route-tipo="multa" asp-route-id="@item.id">Factura / PDF</a>

                        @if (!User.IsInRole("LECTOR"))
                        {
                            <form method="post" style="display:inline">
                                <input type="hidden" name="id" value="@item.id" />
                                <button class="boton boton-claro" asp-page-handler="Editar">Editar</button>
                            </form>

                            @if (!Model.EsPagada(item))
                            {
                                <form method="post" style="display:inline">
                                    <input type="hidden" name="id" value="@item.id" />
                                    <button class="boton" asp-page-handler="Pagar">Marcar pagada</button>
                                </form>
                            }

                            <form method="post" style="display:inline">
                                <input type="hidden" name="id" value="@item.id" />
                                <button class="boton boton-peligro" asp-page-handler="Borrar">Borrar</button>
                            </form>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
