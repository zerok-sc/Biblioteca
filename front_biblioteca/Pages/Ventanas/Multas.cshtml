@page
@model MultasModel
@{
    ViewData["Title"] = "Multas";
}

<h1>Multas</h1>

@if (ViewData.ContainsKey("Mensaje"))
{
    @await Html.PartialAsync("~/Pages/Emergentes/Mensajes.cshtml");
}

<form method="post" class="barra">
    <input type="number" name="FiltroId" value="@Model.FiltroId" placeholder="Buscar por id" />
    <button class="boton" asp-page-handler="Consultar">Consultar</button>
    @if (!User.IsInRole("LECTOR"))
    {
        <button class="boton" asp-page-handler="Nuevo">Nuevo registro</button>
    }
</form>

@if (Model.MostrarFormulario)
{
    <form method="post">
        <input type="hidden" asp-for="Actual.id" />
        <div class="campos">
            <div><label>Valor</label><input asp-for="Actual.valor" /></div>
            <div><label>Fecha</label><input asp-for="Actual.fecha" /></div>
            <div><label>Prestamo libro</label><input asp-for="Actual.prestamo_libro" /></div>
            <div><label>Estado</label><input asp-for="Actual.estado" /></div>
        </div>
        @if (!User.IsInRole("LECTOR"))
        {
            <button class="boton" asp-page-handler="Guardar">Guardar</button>
        }
    </form>
}

<table>
    <thead>
        <tr>
            <th>id</th>
            <th>Valor</th>
            <th>Fecha</th>
            <th>Prestamo libro</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.id</td>
                <td>@item.valor</td>
                <td>@item.fecha</td>
                <td>@item.prestamo_libro</td>
                <td>@item.estado</td>
                <td>
                    <form method="post" style="display:inline">
                        <input type="hidden" name="id" value="@item.id" />
                        @if (!User.IsInRole("LECTOR"))
                        {
                            <button class="boton boton-claro" asp-page-handler="Editar">Editar</button>
                            <button class="boton boton-peligro" asp-page-handler="Borrar">Borrar</button>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
