@page
@model EjemplaresModel
@{
    ViewData["Title"] = "Ejemplares";
}

<h1>Ejemplares</h1>

@if (ViewData.ContainsKey("Mensaje"))
{
    @await Html.PartialAsync("~/Pages/Emergentes/Mensajes.cshtml");
}

<form method="post" class="barra">
    <input type="number" name="FiltroId" value="@Model.FiltroId" placeholder="Buscar por id" />
    <button class="boton" asp-page-handler="Consultar">Consultar</button>
    @if (!User.IsInRole("LECTOR"))
    {
        <button class="boton" asp-page-handler="Nuevo">Nuevo registro</button>
    }
</form>

@if (Model.MostrarFormulario)
{
    <form method="post">
        <input type="hidden" asp-for="Actual.id" />
        <div class="campos">
            <div><label>Codigo</label><input asp-for="Actual.codigo" /></div>
            <div>
                <label>Estado</label>
                <select asp-for="Actual.estado" required asp-items="Model.Catalogos.OpcionesEstados">
                </select>
            </div>
            <div>
                <label>Libro</label>
                <select asp-for="Actual.libro" required asp-items="Model.Catalogos.OpcionesLibros">
                </select>
            </div>
            <div>
                <label>Ubicacion</label>
                <select asp-for="Actual.ubicacion" required asp-items="Model.Catalogos.OpcionesUbicaciones">
                </select>
            </div>
        </div>
        @if (!User.IsInRole("LECTOR"))
        {
            <button class="boton" asp-page-handler="Guardar">Guardar</button>
        }
    </form>
}

<table>
    <thead>
        <tr>
            <th>Codigo</th>
            <th>Estado</th>
            <th>Libro</th>
            <th>Ubicacion</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.codigo</td>
                <td>@Model.Catalogos.NombreEstado(item.estado)</td>
                <td>@Model.Catalogos.NombreLibro(item.libro)</td>
                <td>@Model.Catalogos.NombreUbicacion(item.ubicacion)</td>
                <td>
                    <form method="post" style="display:inline">
                        <input type="hidden" name="id" value="@item.id" />
                        @if (!User.IsInRole("LECTOR"))
                        {
                            <button class="boton boton-claro" asp-page-handler="Editar">Editar</button>
                            <button class="boton boton-peligro" asp-page-handler="Borrar">Borrar</button>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
