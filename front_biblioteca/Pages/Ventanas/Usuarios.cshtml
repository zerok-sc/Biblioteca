@page
@model UsuariosModel
@{
    ViewData["Title"] = "Usuarios";
}

<h1>Usuarios</h1>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="aviso">@Model.Mensaje</div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="error">@Model.Error</div>
}

<form method="post">
    <button class="boton" asp-page-handler="Nuevo">Nuevo registro</button>
</form>

@if (Model.MostrarFormulario)
{
    <form method="post">
        <input type="hidden" asp-for="Actual.id" />
        <div class="campos">
            <div><label>Nombre usuario</label><input asp-for="Actual.nombre_usuario" /></div>
            <div><label>Correo</label><input asp-for="Actual.correo" /></div>
            <div><label>Rol</label><input asp-for="Actual.rol" /></div>
            <div><label>Persona</label><input asp-for="Actual.persona" /></div>
            <div><label>Activo</label><input asp-for="Actual.activo" /></div>
            <div><label>Fecha creacion</label><input asp-for="Actual.fecha_creacion" /></div>
            <div><label>Ultimo acceso</label><input asp-for="Actual.ultimo_acceso" /></div>
        </div>
        <button class="boton" asp-page-handler="Guardar">Guardar</button>
    </form>
}

<table>
    <thead>
        <tr>
            <th>id</th>
            <th>Nombre usuario</th>
            <th>Correo</th>
            <th>Rol</th>
            <th>Persona</th>
            <th>Activo</th>
            <th>Fecha creacion</th>
            <th>Ultimo acceso</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.id</td>
                <td>@item.nombre_usuario</td>
                <td>@item.correo</td>
                <td>@item.rol</td>
                <td>@item.persona</td>
                <td>@item.activo</td>
                <td>@item.fecha_creacion</td>
                <td>@item.ultimo_acceso</td>
                <td>
                    <form method="post" style="display:inline">
                        <input type="hidden" name="id" value="@item.id" />
                        <button class="boton boton-claro" asp-page-handler="Editar">Editar</button>
                        <button class="boton boton-peligro" asp-page-handler="Borrar">Borrar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
