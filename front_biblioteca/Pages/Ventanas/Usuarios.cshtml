@page
@model UsuariosModel
@{
    ViewData["Title"] = "Usuarios";
}

<h1>Usuarios</h1>

@if (ViewData.ContainsKey("Mensaje"))
{
    @await Html.PartialAsync("~/Pages/Emergentes/Mensajes.cshtml");
}

<form method="post" class="barra">
    <input type="number" name="FiltroId" value="@Model.FiltroId" placeholder="Buscar por id" />
    <button class="boton" asp-page-handler="Consultar">Consultar</button>
    @if (!User.IsInRole("LECTOR"))
    {
        <button class="boton" asp-page-handler="Nuevo">Nuevo registro</button>
    }
</form>

@if (User.IsInRole("ADMIN"))
{
    <p><a asp-page="/CrearUsuario" class="boton">Crear usuario</a></p>
}

@if (Model.MostrarFormulario)
{
    <form method="post">
        <input type="hidden" asp-for="Actual.id" />
        <div class="campos">
            <div><label>Nombre usuario</label><input asp-for="Actual.nombre_usuario" required /></div>
            <div><label>Correo</label><input asp-for="Actual.correo" required /></div>
            <div>
                <label>Rol</label>
                <select asp-for="Actual.rol" required asp-items="Model.Catalogos.OpcionesRoles">
                </select>
            </div>
            <div>
                <label>Persona</label>
                <select asp-for="Actual.persona" required asp-items="Model.Catalogos.OpcionesPersonas">
                </select>
            </div>
            <div><label>Activo</label><input asp-for="Actual.activo" /></div>
        </div>
        <p class="ayuda">La clave y la foto no se cambian desde este formulario.</p>
        @if (!User.IsInRole("LECTOR"))
        {
            <button class="boton" asp-page-handler="Guardar">Guardar</button>
        }
    </form>
}

<table>
    <thead>
        <tr>
            <th>id</th>
            <th>Foto</th>
            <th>Nombre usuario</th>
            <th>Correo</th>
            <th>Rol</th>
            <th>Persona</th>
            <th>Activo</th>
            <th>Fecha creacion</th>
            <th>Ultimo acceso</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.id</td>
                <td>
                    @if (item.foto != null && item.foto.Length > 0)
                    {
                        <img height="60" width="60" alt="Foto"
                             src="data:@(item.foto_tipo ?? "image/png");base64,@System.Convert.ToBase64String(item.foto)" />
                    }
                </td>
                <td>@item.nombre_usuario</td>
                <td>@item.correo</td>
                <td>@Model.Catalogos.NombreRol(item.rol)</td>
                <td>@Model.Catalogos.NombrePersona(item.persona)</td>
                <td>@item.activo</td>
                <td>@item.fecha_creacion</td>
                <td>@item.ultimo_acceso</td>
                <td>
                    <form method="post" style="display:inline">
                        <input type="hidden" name="id" value="@item.id" />
                        @if (!User.IsInRole("LECTOR"))
                        {
                            <button class="boton boton-claro" asp-page-handler="Editar">Editar</button>
                            <button class="boton boton-peligro" asp-page-handler="Borrar">Borrar</button>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
