@inject IServiceProvider Servicios
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="menu">
            <a class="marca" asp-page="/Index">
                <img src="~/img/libro.svg" alt="Biblioteca" class="logo" />
                Biblioteca
            </a>
            <a asp-page="/Index">Inicio</a>
            <span class="espacio"></span>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="usuario">
                    @User.Identity.Name
                    <small>(@User.FindFirst("RolNombre")?.Value)</small>
                </span>
                @if (User.IsInRole(Codigos.RolAdmin))
                {
                    <a asp-page="/CrearUsuario">Crear usuario</a>
                }
                @if (User.IsInRole(Codigos.RolLector))
                {
                    <a asp-page="/MisPrestamos">Mis préstamos</a>
                }
                <a asp-page="/Perfil">Mi perfil</a>
                <form method="post" asp-page="/Logout" style="display:inline">
                    <button class="boton boton-claro" type="submit">Salir</button>
                </form>
            }
            else
            {
                <a asp-page="/Login">Ingresar</a>
            }
        </nav>
    </header>
    <main class="contenido">
        @{
            // El aviso es informativo: si la API no responde, la pagina debe seguir funcionando.
            List<string>? codigosFaltantes = null;
            try
            {
                var catalogos = (front_biblioteca.nucleo.Catalogos?)Servicios.GetService(typeof(front_biblioteca.nucleo.Catalogos));
                codigosFaltantes = catalogos?.CodigosFaltantes;
            }
            catch { }
        }
        @if (codigosFaltantes is { Count: > 0 })
        {
            <p class="aviso">Faltan códigos en la base: @string.Join(", ", codigosFaltantes)</p>
        }
        @RenderBody()
    </main>
    <footer>Sistema de gestión de biblioteca - ITM</footer>
</body>
</html>
